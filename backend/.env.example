PORT=3000
LOG_LEVEL=info                       # debug muestra cada frame OCPP

# OCPP
OCPP_DEFAULT_PROTOCOL=ocpp1.6        # si el cargador no envía Sec-WebSocket-Protocol
OCPP_HEARTBEAT_INTERVAL=60           # segundos, devuelto en BootNotification
OCPP_CALL_TIMEOUT_MS=30000
OCPP_BOOT_POLICY=accept-all          # accept-all | known-only
OCPP_KNOWN_CHARGE_POINTS=            # CP-001,CP-002 (para known-only)
OCPP_TRANSACTION_ID_START=1000

# Autorización de idTags
AUTH_POLICY=accept-all               # accept-all | local-list
AUTH_ID_TAGS=                        # ABC123,DEF456 (para local-list)

# MQTT (opcional: si MQTT_URL está vacío el gateway no arranca)
MQTT_URL=                            # mqtt://localhost:1883
MQTT_TOPIC_PREFIX=ev
MQTT_USERNAME=
MQTT_PASSWORD=

# Retención en memoria
RETENTION_ACTIVITY=200
RETENTION_METER_SAMPLES=720
